#!/bin/bash
set -euo pipefail

echo "=== 1. Checking Homebrew installation ==="
# Prüfen, ob brew bereits installiert ist, aber noch nicht im PATH liegt
if [[ -x "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x "/usr/local/bin/brew" ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
elif [[ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

if ! command -v brew &> /dev/null; then
    echo "Homebrew not found. Starting installation..."
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://githubusercontent.com)"
    
    # Nach der Installation in den aktuellen PATH laden
    if [[ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]]; then
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    elif [[ -x "/opt/homebrew/bin/brew" ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    fi
fi

# Paketliste in einer Variable speichern, damit wir sie zweimal nutzen können
BREWFILE_CONTENT=$(cat <<EOF
brew "bat"
brew "chezmoi"
brew "eza"
brew "fd"
brew "fzf"
brew "gomi"
brew "jq"
brew "ripgrep"
brew "starship"
brew "zoxide"
brew "zsh-completions"
brew "zsh-history-substring-search"
EOF
)

echo "=== 2. Installing Homebrew packages ==="
echo "$BREWFILE_CONTENT" | brew bundle --file=/dev/stdin

echo "=== 3. Cleaning up unlisted Homebrew packages ==="
echo "$BREWFILE_CONTENT" | brew bundle cleanup --file=/dev/stdin --force

echo "=== 4. Unlinking Homebrew zsh (prefer system zsh) ==="
brew unlink zsh 2>/dev/null || true

echo "=== Done! All packages are up to date. ==="

